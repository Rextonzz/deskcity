# Paste your real keys here. This file is ignored by git, so keep it private.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
# Other providers the hub can run workers on (Hub kit). Leave blank the ones you don't use.
# OpenAI: platform.openai.com > API keys. Grok: console.x.ai. DeepSeek: platform.deepseek.com. Muse (Meta): META_API_KEY.
OPENAI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
META_API_KEY=
# Local models need no key: run Ollama (ollama.com) or LM Studio, then set its address in data/hub-settings.json
# under providers.local.baseUrl (Ollama: http://localhost:11434/v1, LM Studio: http://localhost:1234/v1).

# Optional settings
# PORT is where the hub listens; the hook and the agent-log tool read it from this file too, so they find a hub on another port.
# HUB_URL=http://localhost:3000 (only if the tools run on another machine or the hub is not on this PC's localhost)
PORT=3000
CLAUDE_MODEL=claude-opus-5-5

# Dashboard password, stored only as a hash. Set it with `npm run set-password` (needed to open the app from your phone).
DASHBOARD_PASSWORD_HASH=
# Made automatically: signs sign-in cookies. Delete it to sign every device out.
DASHBOARD_SESSION_KEY=
# Optional: authenticator-app code at sign-in. Run `npm run 2fa` to make one.
DASHBOARD_TOTP_SECRET=
# Who can reach the app: local (this PC), tailscale, lan (home Wi-Fi). Default is local,tailscale (this PC and Tailscale); home Wi-Fi (lan) is opt-in. Internet visitors are always refused.
# This only matters once the hub listens on the network at all: it listens on this PC only (127.0.0.1) until HUB_LISTEN=all
# (or "network.listen": "all" in data/hub-settings.json) and a dashboard password is set.
# DASHBOARD_NETWORKS=local,tailscale
# HUB_LISTEN=local

# World of Warcraft (optional). Warcraft Logs: warcraftlogs.com > Settings > API clients (V2 client).
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=
# Battle.net: develop.battle.net > API Access > Create client.
BNET_CLIENT_ID=
BNET_CLIENT_SECRET=

# PR reviews of the hub's own repo: a GitHub token that can READ pull requests on it (fine-grained: Pull requests,
# read-only, and Contents read-only). Leave empty to skip. Never needs write access.
HUB_GITHUB_TOKEN=