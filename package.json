{
  "name": "deskcity",
  "version": "0.2.0",
  "description": "A home base for every AI working on your projects: staff, jobs, costs and a campus, on your own computer.",
  "main": "server.js",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "signin": "node src/signin.js",
    "2fa": "node src/twofa.js",
    "set-password": "node src/setpassword.js",
    "demo": "node tools/demo.mjs",
    "update": "node tools/update.mjs",
    "addons:install": "node tools/addons-install.mjs",
    "self-check": "node tools/self-check.mjs",
    "test": "node tools/run-tests.mjs",
    "check": "node tools/syntax-check.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
